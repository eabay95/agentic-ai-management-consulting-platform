LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# auto prefers Gemini when GEMINI_API_KEY is set; otherwise uses an OpenAI key.
# Set LLM_PROVIDER=gemini or openai to select explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# local uses reproducible lexical hashing embeddings, without a model download.
# openai uses semantic embeddings; rebuild the index when changing backend/model.
EMBEDDING_BACKEND=local
